#!/bin/sh
set -eu

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Validate the Actor/App backend. Offline builds use a caller-provided cached
# DAAT_LOCUS_MODEL_CATALOG_PATH; model providers in tests are mocks.
export DAAT_LOCUS_BUILD_WEBUI=0
cargo fmt --all -- --check
cargo clippy --locked -p daat-locus -p daat-locus-auth -p daat-locus-client-protocol -p daat-locus-macros -p xtask --all-targets -- -D warnings
cargo test --locked -p daat-locus --lib --bins --test http_api
cargo test --locked -p daat-locus-auth -p daat-locus-client-protocol -p daat-locus-macros -p xtask

if ! command -v bun >/dev/null 2>&1; then
    printf 'Bun is required for WebUI infrastructure checks.\n' >&2
    exit 1
fi

(
    cd webui
    bun run typecheck
    bun run test
)

(
    cd workers/signaling
    bun run typecheck
    bun test
)
