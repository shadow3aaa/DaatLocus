  <String Id="WelcomeHeading" Value="欢迎安装 Daat Locus"/>
  <String Id="WelcomeNotice" Value="向导将引导你查看许可条款，并确认驱动安装所需的权限。点击下一步开始。"/>
  <String Id="Next" Value="下一步(&amp;N)"/>
  <String Id="DriverNextNotice" Value="点击下一步继续。驱动更改将在最后一页确认安装后开始。"/>
  <String Id="InstallHeading" Value="准备安装"/>
  <String Id="InstallLocation" Value="为当前账户安装到：&#10;[LocalAppDataFolder]Daat Locus"/>
