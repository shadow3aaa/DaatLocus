  <String Id="ModifyHeading" Value="管理安装"/>
  <String Id="ModifyNotice" Value="修复将重新安装 Daat Locus，并修复虚拟显示器和工作区支持。更改驱动需要管理员授权。&#10;&#10;卸载将移除 Daat Locus，保留共用驱动和你的数据。"/>
  <String Id="Repair" Value="修复 Daat Locus 和驱动"/>
