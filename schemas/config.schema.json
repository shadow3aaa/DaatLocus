{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Config",
  "type": "object",
  "properties": {
    "daemon": {
      "$ref": "#/$defs/DaemonConfig",
      "default": {
        "port": 53825
      }
    },
    "efficient_model": {
      "description": "Efficient model name; key reference into models.\nDefault for non-main-loop operations such as judge.\nWhen not set explicitly, defaults to the same value as `main_model` for backward compatibility.",
      "type": "string",
      "default": "default"
    },
    "judge": {
      "$ref": "#/$defs/JudgeConfig",
      "default": {
        "enabled": true,
        "max_pairwise_candidates": 4,
        "max_pairwise_cases": 4,
        "model": null
      }
    },
    "locale": {
      "$ref": "#/$defs/Locale",
      "default": "en-US"
    },
    "main_model": {
      "description": "Main model name; key reference into models.",
      "type": "string",
      "default": "default"
    },
    "models": {
      "description": "Model definition registry keyed by user-defined names.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ModelConfig"
      },
      "default": {
        "default": {
          "api_style": null,
          "auto_compact_token_limit": null,
          "context_window_tokens": 128000,
          "effective_context_window_percent": 95,
          "max_completion_tokens": 4000,
          "model_id": "gpt-4.1",
          "provider": "openai",
          "request_timeout_secs": 300,
          "rpm": null,
          "stream_idle_timeout_secs": 900,
          "supports_vision": null,
          "temperature": 1.0,
          "thinking_budget": null,
          "tool_output_max_tokens": 2000
        }
      }
    },
    "providers": {
      "description": "Provider credential registry keyed by user-defined names.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/ProviderConfig"
      },
      "default": {
        "openai": {
          "api_key": "your-api-key",
          "base_url": null,
          "type": "openai"
        }
      }
    },
    "sandbox": {
      "$ref": "#/$defs/SandboxConfig",
      "default": {
        "enabled": true,
        "strong_filesystem": "off"
      }
    },
    "telegram": {
      "$ref": "#/$defs/TelegramConfig",
      "default": {
        "bot_token": "your-telegram-bot-token",
        "enabled": true,
        "poll_timeout_secs": 30
      }
    }
  },
  "$defs": {
    "DaemonConfig": {
      "type": "object",
      "properties": {
        "port": {
          "type": "integer",
          "format": "uint16",
          "default": 53825,
          "maximum": 65535,
          "minimum": 0
        }
      }
    },
    "JudgeConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "max_pairwise_candidates": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "max_pairwise_cases": {
          "type": "integer",
          "format": "uint",
          "default": 4,
          "minimum": 0
        },
        "model": {
          "description": "None = use `main_model`.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      }
    },
    "Locale": {
      "type": "string",
      "enum": [
        "en-US",
        "zh-CN"
      ]
    },
    "ModelConfig": {
      "type": "object",
      "properties": {
        "api_style": {
          "description": "Selects the request/response protocol used against the provider endpoint.\nOnly honored for `openai-compatible` providers, which expose both the\nchat-completions and responses APIs under one base URL.  Set to\n`\"responses\"` to use the `/responses` endpoint; any other value (or\n`None`) uses chat completions.",
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "auto_compact_token_limit": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "default": null,
          "minimum": 0
        },
        "context_window_tokens": {
          "type": "integer",
          "format": "uint",
          "default": 128000,
          "minimum": 0
        },
        "effective_context_window_percent": {
          "type": "integer",
          "format": "int64",
          "default": 95
        },
        "max_completion_tokens": {
          "type": "integer",
          "format": "uint",
          "default": 4000,
          "minimum": 0
        },
        "model_id": {
          "description": "Model identifier sent to the provider API.",
          "type": "string",
          "default": "gpt-4.1"
        },
        "provider": {
          "description": "Key reference into Config.providers.",
          "type": "string",
          "default": "openai"
        },
        "request_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 300,
          "minimum": 0
        },
        "rpm": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "default": null,
          "minimum": 0
        },
        "stream_idle_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 900,
          "minimum": 0
        },
        "supports_vision": {
          "description": "Explicitly set whether this model accepts image attachments in messages.\nWhen `None`, vision support is inferred from the model name via the\nbuilt-in catalog heuristic.  Set to `false` to unconditionally strip\nimages before sending; set to `true` to skip runtime detection and\nalways include images.",
          "type": [
            "boolean",
            "null"
          ],
          "default": null
        },
        "temperature": {
          "type": "number",
          "format": "double",
          "default": 1.0
        },
        "thinking_budget": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tool_output_max_tokens": {
          "type": "integer",
          "format": "uint",
          "default": 2000,
          "minimum": 0
        }
      }
    },
    "ProviderConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string"
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "openai"
            }
          },
          "required": [
            "type",
            "api_key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "github_token": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "github-copilot"
            }
          },
          "required": [
            "type",
            "github_token"
          ]
        },
        {
          "type": "object",
          "properties": {
            "auth_file": {
              "type": "string",
              "default": ""
            },
            "base_url": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "openai-codex-oauth"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_key": {
              "type": "string"
            },
            "base_url": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "openai-compatible"
            }
          },
          "required": [
            "type",
            "base_url",
            "api_key"
          ]
        },
        {
          "type": "object",
          "properties": {
            "api_key": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "host": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "keep_alive": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "type": {
              "type": "string",
              "const": "ollama"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "SandboxConfig": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "strong_filesystem": {
          "$ref": "#/$defs/StrongFilesystemSandboxMode",
          "default": "off"
        }
      }
    },
    "StrongFilesystemSandboxMode": {
      "type": "string",
      "enum": [
        "off",
        "auto",
        "required"
      ]
    },
    "TelegramConfig": {
      "type": "object",
      "properties": {
        "bot_token": {
          "type": "string",
          "default": "your-telegram-bot-token"
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "poll_timeout_secs": {
          "type": "integer",
          "format": "uint64",
          "default": 30,
          "minimum": 0
        }
      }
    }
  }
}
