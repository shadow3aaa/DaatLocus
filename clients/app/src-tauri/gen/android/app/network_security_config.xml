<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Build merges these local exceptions with the pinned TLS verifier's CRL hosts. -->
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">tauri.localhost</domain>
        <domain includeSubdomains="false">ipc.localhost</domain>
        <domain includeSubdomains="false">dl-resource.localhost</domain>
    </domain-config>
</network-security-config>
