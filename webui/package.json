{
  "name": "daat-locus-webui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "bun run build:auth && vite",
    "build:auth": "bun scripts/build-auth.ts",
    "build": "bun run build:auth && tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "bun test",
    "typecheck": "bun run build:auth && tsc -p tsconfig.json --noEmit",
    "typecheck:mock": "tsc -p tsconfig.mock.json --noEmit",
    "mock": "bun mock/server.ts",
    "dev:mock": "DAAT_LOCUS_MOCK=1 vite"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "i18next": "^26.3.4",
    "lucide-react": "^1.22.0",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.12.0",
    "shiki": "^4.3.0",
    "tailwind-merge": "^3.6.0",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/node": "^25.9.4",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.0.3",
    "html2canvas": "^1.4.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vite": "^8.1.2"
  }
}
